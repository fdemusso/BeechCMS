{
  "name": "@beechcms/cms",
  "version": "0.4.3",
  "packageManager": "npm@11.9.0",
  "description": "Edge-Native, Schema-Driven Headless CMS built on Cloudflare Workers, D1, and R2. Features the Botanical Engine for alias-stable field management, a modular widget layer, and a React + Vite admin dashboard.",
  "keywords": [
    "cms",
    "headless-cms",
    "cloudflare",
    "cloudflare-workers",
    "d1",
    "edge",
    "schema-driven",
    "api-first",
    "hono",
    "react",
    "turborepo"
  ],
  "author": "Flavio De Musso",
  "license": "MIT",
  "homepage": "https://github.com/fdemusso/BeechCMS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdemusso/BeechCMS.git"
  },
  "bugs": {
    "url": "https://github.com/fdemusso/BeechCMS/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "files": [
    "bin/",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "beechcms": "bin/create.mjs",
    "beech": "bin/cli.mjs"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "setup:graph": "node scripts/setup-graph.mjs",
    "release": "node scripts/release.mjs",
    "release:preview": "node scripts/release.mjs --preview"
  },
  "type": "module",
  "devDependencies": {
    "shadcn": "^4.4.0",
    "turbo": "^2.8.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@beechcms/cli": "^0.4.3",
    "@clack/prompts": "^0.9.1",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@beechcms/api": "^0.4.3",
    "@beechcms/core": "^0.4.3"
  },
  "peerDependenciesMeta": {
    "@beechcms/api": {
      "optional": true
    },
    "@beechcms/core": {
      "optional": true
    }
  }
}
