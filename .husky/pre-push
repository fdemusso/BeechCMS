#!/bin/sh
#
# Non-blocking type check of apps/api, tests included (~10 s). It only WARNS: this hook always
# exits 0, so a push is never stopped by it.
#
# Why it exists: the API build (tsconfig.build.json) and CI exclude test files, so a type error
# in a test is otherwise invisible; vitest transpiles without type-checking.
# Skip with:   SKIP_TSC=1 git push
#
# docs/api is NOT regenerated here any more. .github/workflows/generate-docs.yml does it on every
# push to master and commits the result. Regenerate locally with: pnpm docs:generate

if [ -n "$SKIP_TSC" ]; then
  echo "pre-push: SKIP_TSC set, skipping type check"
  exit 0
fi

output=$(pnpm --dir apps/api exec tsc --noEmit 2>&1)
status=$?

if [ "$status" -ne 0 ]; then
  count=$(printf '%s\n' "$output" | grep -c "error TS")
  echo ""
  echo "pre-push: WARNING - apps/api has $count TypeScript error(s). The push continues."
  printf '%s\n' "$output" | grep "error TS" | head -20
  [ "$count" -gt 20 ] && echo "  ... and $((count - 20)) more. Run: pnpm --dir apps/api exec tsc --noEmit"
  echo ""
fi

exit 0
