### Phase A — Backend: Unified Drafts API

#### Files to modify:
- `apps/api/src/features/draft/draft.handler.ts`
  Expose a new endpoint `GET /drafts` (mounted under `/api/content/drafts`):
  ```typescript
  // GET /drafts — Retrieves all pending drafts across all seeds in a single query
  draftApp.get('/drafts', async (context) => {
    const repository = context.get('repository')
    const seedRegistry = context.get('seedRegistry')
    
    // Find all seeds allowing drafts
    const seeds = seedRegistry.all().filter((s) => s.allowDrafts)
    if (seeds.length === 0) {
      return context.json([])
    }

    // Build a dynamic UNION ALL query to scan all draft tables in a single D1 execution
    const unionSelects: string[] = []
    const bindings: string[] = []

    for (const seed of seeds) {
      const draftTable = `content_${seed.slug}_drafts`
      const liveTable = `content_${seed.slug}`
      const titleColumn = seed.displayNameAlias ?? 'title'

      unionSelects.push(`
        SELECT 
          ? as seed_slug,
          ? as seed_label,
          d.entry_id as id,
          d.updated_at,
          COALESCE(d.${titleColumn}, l.${titleColumn}) as title
        FROM ${draftTable} d
        LEFT JOIN ${liveTable} l ON l.id = d.entry_id
      `)
      bindings.push(seed.slug, seed.labelPlural ?? seed.label)
    }

    const unionSql = unionSelects.join('\nUNION ALL\n')

    // CTE query joining the union results with activity_logs for actor details
    const fullSql = `
      WITH all_drafts AS (
        ${unionSql}
      )
      SELECT 
        ad.seed_slug as seedSlug,
        ad.seed_label as seedLabel,
        ad.id,
        ad.updated_at as updatedAt,
        ad.title,
        al.user_name as last_modified_by_name,
        al.user_email as last_modified_by_email
      FROM all_drafts ad
      LEFT JOIN activity_logs al ON al.entity_id = ad.id 
                                 AND al.entity_slug = ad.seed_slug
                                 AND al.id = (
                                   SELECT id FROM activity_logs
                                   WHERE entity_id = ad.id 
                                     AND entity_slug = ad.seed_slug
                                     AND action = 'update'
                                   ORDER BY created_at DESC LIMIT 1
                                 )
      ORDER BY ad.updated_at DESC
    `

    try {
      const stmt = repository.database.prepare(fullSql).bind(...bindings)
      const { results } = await stmt.all()

      const draftsList = (results || []).map((row: any) => ({
        id: row.id,
        seedSlug: row.seedSlug,
        seedLabel: row.seedLabel,
        title: row.title || row.id,
        updatedAt: row.updatedAt,
        lastModifiedBy: {
          name: row.last_modified_by_name || 'Unknown',
          email: row.last_modified_by_email || ''
        }
      }))

      return context.json(draftsList)
    } catch (err) {
      console.error('Unified drafts query error:', err)
      return context.json([], 500)
    }
  })
  ```

