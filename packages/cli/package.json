{
  "name": "@beechcms/cli",
  "version": "0.9.2",
  "type": "module",
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --external:@beechcms/core --external:@clack/prompts --external:picocolors --platform=node --format=esm --outfile=dist/index.js",
    "dev": "esbuild src/index.ts --bundle --external:@beechcms/core --external:@clack/prompts --external:picocolors --platform=node --format=esm --outfile=dist/index.js --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@beechcms/core": "workspace:^0.9.2",
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1",
    "wrangler": "^4.100.0"
  },
  "devDependencies": {
    "@beechcms/api-client": "workspace:^0.1.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT"
}
