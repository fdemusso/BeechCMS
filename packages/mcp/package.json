{
  "name": "@beechcms/mcp",
  "version": "1.0.2",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "beechcms-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "resources",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle-resources.mjs && esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --outfile=dist/index.js",
    "dev": "esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --outfile=dist/index.js --watch",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@beechcms/api-client": "workspace:^0.1.0",
    "@beechcms/core": "workspace:^0.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "license": "MIT"
}
