# =============================================================================
# .npmignore — controls what goes into the npm tarball
# Only files needed to run Beech CMS are published.
# Everything else is excluded.
# =============================================================================

# --- SECRETS (critical) ------------------------------------------------------
apps/api/.dev.vars
apps/api/seed.ts
apps/api/seeds.ts
**/.env
**/.env.*
!**/.env.example
!**/.dev.vars.example

# --- CI / DevOps -------------------------------------------------------------
.github/
.semgrepignore
sonar-project.properties

# --- IDE / Editor config -----------------------------------------------------
.cursor/
.claude/
.idea/
.cursorrules
.mcp.json

# --- Test files --------------------------------------------------------------
**/*.test.ts
**/*.spec.ts
apps/api/test/
apps/api/vitest.config.ts
apps/dashboard/src/test/
apps/dashboard/src/pages/test-fields.tsx
apps/dashboard/src/pages/widget-lab.tsx
apps/dashboard/vitest.config.ts

# --- Turborepo / build artifacts ---------------------------------------------
.turbo/
apps/api/.wrangler/
apps/api/coverage/
apps/dashboard/dist/
packages/core/dist/
packages/core/tsconfig.tsbuildinfo

# --- Incremental migrations (only 0000_v040_base.sql is needed) ---------
apps/api/migrations/_archive/
apps/api/migrations/0028_v040_seed_data.sql

# --- Agents / internal tooling -----------------------------------------------
apps/dashboard/.agents/
graphify-out/
GRAPH_REPORT.md
.graphifyignore
graphify-obsidian/
graphify-obsidian/
.graphifyignore
scratch/

# AI / Agents (local)
.agents/
.claude/
.cursor/
.cursorrules
.mcp.json
