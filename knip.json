{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "bin/*.mjs",
        "scripts/**/*.{mjs,js,ts,tsx}",
        "docs/.vitepress/config.mts",
        "docs/.vitepress/theme/index.ts"
      ],
      "project": [
        "bin/**/*.mjs",
        "scripts/**/*.{mjs,js,ts,tsx}",
        "docs/.vitepress/**/*.{ts,mts}"
      ]
    },
    "apps/api": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "scripts/**/*.mjs"
      ],
      "ignoreDependencies": [
        "cloudflare"
      ]
    },
    "apps/dashboard": {
      "project": [
        "src/**/*.{ts,tsx,css}"
      ],
      "ignoreDependencies": [
        "@tiptap/extension-bubble-menu",
        "@tiptap/extension-floating-menu",
        "typescript-eslint"
      ]
    },
    "e2e": {
      "entry": [
        "tests/**/*.e2e.ts",
        "tests/global.setup.ts",
        "scripts/*.mjs"
      ],
      "project": [
        "**/*.{ts,mjs}"
      ],
      "ignoreDependencies": [
        "@beechcms/api",
        "@beechcms/core",
        "@beechcms/dashboard"
      ]
    },
    "packages/mcp": {
      "entry": [
        "scripts/*.mjs"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "docs/examples/*": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  },
  "ignoreBinaries": [
    "tail",
    "winget",
    "brew",
    "xdg-open"
  ],
  "ignoreIssues": {
    "apps/dashboard/src/components/ui/**": [
      "exports",
      "types",
      "duplicates"
    ],
    "apps/dashboard/src/features/**/index.ts": [
      "exports",
      "types"
    ],
    "apps/api/src/**/index.ts": [
      "exports",
      "types"
    ]
  }
}
