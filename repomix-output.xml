        seed={seed}
        entryIds={["id-1"]}
        onConfirm={onConfirm}
      />
    )

    fireEvent.click(screen.getByRole("button", { name: /^elimina$/i }))

    expect(await screen.findByText("Errore custom delete")).toBeInTheDocument()
    expect(onOpenChange).not.toHaveBeenCalledWith(false)
  })
})
