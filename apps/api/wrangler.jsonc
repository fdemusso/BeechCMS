{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beech-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-13",

  // Necessario per bcryptjs (usa Node.js crypto)
  "compatibility_flags": ["nodejs_compat"],

  // Database D1 (recupera l'ID con: npx wrangler d1 list)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beech-db",
      "database_id": "INCOLLA_QUI_IL_TUO_ID_D1"
    }
  ],

  // R2: usa API S3-compatibile con chiavi (configura in .dev.vars per locale, wrangler secret per produzione)
  // Crea il bucket: npx wrangler r2 bucket create beech-media
  // Chiavi: Dashboard Cloudflare → R2 → Manage R2 API Tokens

  // Rate limiting (Wrangler 4.36+)
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "REFRESH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  // CORS e variabili
  "vars": {
    "JWT_SECRET": "sviluppo-secret-cambiami",
    "CORS_ORIGINS": "http://localhost:5173,http://localhost:5174,https://dashboard.beech.local",
    "ENV": "development"
  }
}