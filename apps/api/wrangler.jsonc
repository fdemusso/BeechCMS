{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beech-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-13",

  // Dashboard SPA — Workers Assets
  // Monorepo dev: punta a ../dashboard/dist (build dashboard prima: pnpm --filter @beechcms/dashboard build)
  // Progetto utente: punta a node_modules/@beechcms/api/assets/dashboard
  "assets": {
    "binding": "ASSETS",
    "directory": "../dashboard/dist",
    "not_found_handling": "none"
  },

  // Necessario per bcryptjs (usa Node.js crypto)
  "compatibility_flags": ["nodejs_compat"],

  // Database D1 (recupera l'ID con: npx wrangler d1 list)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beech-db",
      "database_id": "INCOLLA_QUI_IL_TUO_ID_D1",
      "migrations_dir": "migrations"
    }
  ],

  // R2 (S3 API). In dev imposta in .dev.vars; in prod come wrangler secret:
  //   R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
  //   MEDIA_CDN_URL (opzionale)
  //   MAX_UPLOAD_BYTES (opzionale, default 50MB)

  // Rate limiting (Wrangler 4.36+)
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "REFRESH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "PUBLIC_READ_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "PUBLIC_WRITE_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "FORGOT_PASSWORD_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "RESET_PASSWORD_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "queues": {
    "producers": [
      { "binding": "QUEUE", "queue": "beech-jobs" }
    ],
    "consumers": [
      {
        "queue": "beech-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },

  "triggers": {
    "crons": ["* * * * *"]
  },

  // ─── Variabili di default (sviluppo locale) ──────────────────────────────────
  // Queste vars sono usate da `wrangler dev`. NON vengono usate in produzione:
  // il deploy usa `wrangler deploy --env production` che eredita la sezione
  // `env.production` qui sotto, sovrascrivendo ENV e rimuovendo le var dev-only.
  //
  // Secrets che NON devono mai stare in vars (né qui né in env.production):
  //   JWT_SECRET          → npx wrangler secret put JWT_SECRET --env production
  //   RESEND_API_KEY      → npx wrangler secret put RESEND_API_KEY --env production
  //   PUBLIC_READ_API_KEY → npx wrangler secret put PUBLIC_READ_API_KEY --env production
  //   PUBLIC_WRITE_API_KEY→ npx wrangler secret put PUBLIC_WRITE_API_KEY --env production
  //   WEBHOOK_SECRET      → npx wrangler secret put WEBHOOK_SECRET --env production
  //   R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ENDPOINT, R2_BUCKET_NAME
  "vars": {
    "ENV": "development",
    "CORS_ORIGINS": "http://localhost:5173,http://localhost:5174,https://dashboard.beech.local",
    "PUBLIC_READ_API_KEY": "dev-public-read-key-changeme",
    "PUBLIC_WRITE_API_KEY": "dev-public-write-key-changeme",
    "PUBLIC_PUBLISHED_ONLY": "true",
    "PUBLIC_IDEMPOTENCY_TTL_SECONDS": "86400",
    "MEDIA_BASE_URL": "http://localhost:5173",
    "DATE_FORMAT": "DD-MM-YYYY",
    "APP_URL": "http://localhost:5173",
    // In dev locale: EMAIL_PROVIDER=smtp punta Mailpit su localhost:8025.
    "EMAIL_PROVIDER": "smtp",
    "SMTP_HOST": "localhost",
    "SMTP_PORT": "8025",
    "EMAIL_FROM": "Beech CMS <dev@beech.local>",
    "WEBHOOK_TESTER_URL": "http://localhost:8084",
    "WEBHOOK_SECRET": "dev-webhook-secret-changeme"
  },

  // ─── Ambiente di produzione ───────────────────────────────────────────────────
  // Usato da: `wrangler deploy --env production` (vedi script "deploy" in package.json).
  // Sovrascrive le vars top-level; i binding (d1, ratelimits, queues) vengono ereditati.
  //
  // Prima del primo deploy, configura i secrets con:
  //   npx wrangler secret put JWT_SECRET --env production
  //   npx wrangler secret put RESEND_API_KEY --env production
  //   npx wrangler secret put PUBLIC_READ_API_KEY --env production
  //   npx wrangler secret put PUBLIC_WRITE_API_KEY --env production
  //   npx wrangler secret put WEBHOOK_SECRET --env production
  //   npx wrangler secret put R2_ACCESS_KEY_ID --env production
  //   npx wrangler secret put R2_SECRET_ACCESS_KEY --env production
  //   npx wrangler secret put R2_ENDPOINT --env production
  //   npx wrangler secret put R2_BUCKET_NAME --env production
  "env": {
    "production": {
      "vars": {
        // ✅ FIX: ENV=production attiva i rate limiter Cloudflare (login, refresh,
        // forgotPassword, resetPassword, publicApiRead, publicApiWrite).
        "ENV": "production",

        // Sostituisci con il dominio reale del tuo progetto:
        "CORS_ORIGINS": "https://SOSTITUISCI_CON_IL_TUO_DOMINIO",
        "APP_URL": "https://SOSTITUISCI_CON_IL_TUO_DOMINIO",
        "MEDIA_BASE_URL": "https://SOSTITUISCI_CON_IL_TUO_DOMINIO",

        "PUBLIC_PUBLISHED_ONLY": "true",
        "PUBLIC_IDEMPOTENCY_TTL_SECONDS": "86400",
        "DATE_FORMAT": "DD-MM-YYYY",

        // In produzione usa Resend (o altro provider SMTP reale).
        // Imposta RESEND_API_KEY come wrangler secret (non qui).
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM": "Beech CMS <noreply@SOSTITUISCI_CON_IL_TUO_DOMINIO>"

        // Le seguenti vars NON compaiono qui: sono wrangler secrets.
        // PUBLIC_READ_API_KEY, PUBLIC_WRITE_API_KEY, JWT_SECRET,
        // RESEND_API_KEY, WEBHOOK_SECRET, R2_*, SMTP_*
      }
    }
  }
}