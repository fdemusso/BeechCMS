# Variabili per wrangler dev (locale).
# Copia in .dev.vars e compila con i tuoi valori.
# .dev.vars è in .gitignore - NON committare mai le chiavi reali.
#
# Per produzione: wrangler secret put R2_ACCESS_KEY_ID, ecc.

# =============================================================================
# Auth — JWT_SECRET (>= 32 byte casuali). In prod: wrangler secret put JWT_SECRET
# =============================================================================
JWT_SECRET=sviluppo-secret-cambiami-almeno-32-byte-per-sicurezza-hono

# Dev con MinIO (npm run dev:full):
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=beechdev
R2_SECRET_ACCESS_KEY=beechdevsecret
R2_BUCKET_NAME=beech-media
MAX_UPLOAD_BYTES=52428800

# Dev con R2 staging:
# R2_ACCESS_KEY_ID=tuo_access_key_id_qui
# R2_SECRET_ACCESS_KEY=tua_secret_access_key_qui
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET_NAME=beech-media

# Opzionale: URL base per i media (se non impostato, usa origin della richiesta)
# MEDIA_BASE_URL=http://localhost:5173

# --- Email (Sprint 03) ---
# In dev usa Mailpit. In prod (wrangler secret) imposta EMAIL_PROVIDER=resend e RESEND_API_KEY.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=8025
EMAIL_FROM=Beech CMS <dev@beech.local>

# --- Webhook tester (Sprint 03, solo dev/test) ---
WEBHOOK_TESTER_URL=http://localhost:8084

# --- QStash notifications (opzionale) ---
# APP_URL = URL del dashboard, usato nei link delle email (es. reset password).
APP_URL=http://localhost:5173
# QSTASH_CALLBACK_URL = URL pubblico del worker, usato da QStash per richiamare
# il webhook /api/webhooks/qstash. `npm run dev:full` lo popola automaticamente
# con l'URL del tunnel cloudflared (servizio "tunnel" in docker-compose.yml) —
# non serve impostarlo a mano né installare ngrok.
# Se assente, QStash non viene usato e le notifiche restano in modalità background locale.
QSTASH_CALLBACK_URL=
# QSTASH_TOKEN=<your-qstash-token>
# QSTASH_CURRENT_SIGNING_KEY=<sig_...>
# QSTASH_NEXT_SIGNING_KEY=<sig_...>
