# Variabili per wrangler dev (locale).
# Copia in .dev.vars e compila con i tuoi valori.
# .dev.vars è in .gitignore - NON committare mai le chiavi reali.
#
# Per produzione: wrangler secret put R2_ACCESS_KEY_ID, ecc.

# R2 - API S3-compatibile (obbligatorie per upload/media)
# Chiavi: Dashboard Cloudflare → R2 → Manage R2 API Tokens
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (ACCOUNT_ID in Dashboard)
R2_ACCESS_KEY_ID=tuo_access_key_id_qui
R2_SECRET_ACCESS_KEY=tua_secret_access_key_qui
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=beech-media

# Opzionale: URL base per i media (se non impostato, usa origin della richiesta)
# Dev con proxy Vite: http://localhost:5173
# MEDIA_BASE_URL=http://localhost:5173
